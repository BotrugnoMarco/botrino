# ===============================
# Botrino - Configurazione
# ===============================
# Copia questo file in .env e compila i valori.
# [OBBLIGATORIA] = il bot non parte senza. [OPZIONALE] = può restare vuota (vale il default indicato).

# [OBBLIGATORIA] Token del bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN="IL_TUO_TOKEN_QUI"

# ===============================
# MySQL Database
# ===============================

# [OBBLIGATORIE] Credenziali del database
MYSQL_HOST="localhost"
MYSQL_USER="il_tuo_utente"
MYSQL_PASSWORD="la_tua_password"
MYSQL_DB="discord_bot"

# ===============================
# Canali
# ===============================

# [OBBLIGATORIA] ID del canale dove inviare i report giornalieri e settimanali
REPORT_CHANNEL_ID=123456789012345678

# [OBBLIGATORIA] ID del canale dove inviare i messaggi di benvenuto
WELCOME_CHANNEL_ID=123456789012345678

# [OPZIONALE] ID del canale dove pubblicare gli aggiornamenti del bot
UPDATES_CHANNEL_ID=

# [OPZIONALE] Canali vocali da escludere dalla classifica canali del report (separati da virgola)
REPORT_EXCLUDE_CHANNEL_IDS=

# ===============================
# Aspetto e fuso orario
# ===============================

# [OPZIONALE] Colore primario degli embed in esadecimale: accetta sia 0x3498db sia 3498db (default 2E8B57)
PRIMARY_COLOR=0x3498db

# [OPZIONALE] Fuso orario per report e statistiche, formato IANA (default UTC)
ZONE="Europe/Rome"

# [OPZIONALE] Username di Ko-fi per il comando !donate e i link di supporto
KOFI_USERNAME=

# ===============================
# AFK
# ===============================

# [OPZIONALE] Canali AFK, separati da virgola: il tempo trascorso qui non viene tracciato.
# Il primo è il canale in cui vengono spostati gli utenti mutati (vuoto = spostamento disattivato).
AFK_CHANNEL_IDS=

# [OPZIONALE] Minuti da mutato prima dello spostamento in AFK (default 30)
AFK_MOVE_TIMEOUT_MINUTES=30

# [OPZIONALE] ID degli utenti mai spostati in AFK (separati da virgola)
AFK_EXCLUDED_USER_IDS=

# [OPZIONALE] Canali dove mutarsi non causa lo spostamento in AFK (separati da virgola)
AFK_EXEMPT_CHANNEL_IDS=

# ===============================
# XP e livelli
# ===============================

# [OPZIONALI] Valori di default indicati qui sotto
XP_PER_MINUTE=3
XP_PER_MESSAGE=2
XP_PER_REACTION=1
XP_FOR_REACTION_RECEIVED=2
BASE_XP_FOR_LEVEL_UP=250
# Secondi minimi tra due messaggi che danno XP
MESSAGE_COOLDOWN=30

# [OPZIONALE] Ruoli assegnati al raggiungimento di un livello.
# Formato: livello:id_ruolo separati da virgola, es. "5:123456789012345678,15:234567890123456789"
LEVEL_ROLES=

# ===============================
# botctl.sh
# ===============================

# [OPZIONALE] Webhook Discord per notifiche di avvio/arresto/aggiornamento ed errori critici
WEBHOOK_URL=

# [OPZIONALE] Cartella del bot (default: la cartella di botctl.sh)
BOT_DIR=
# [OPZIONALE] Script da avviare (default bot.py)
BOT_SCRIPT=bot.py
# [OBBLIGATORIA per botctl.sh] Script di attivazione del virtualenv
VENV=/percorso/al/tuo/bot/venv/bin/activate
